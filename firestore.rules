rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAdmin() {
      return request.auth != null && 
        (request.auth.token.email.lower() == 'stormychaseforrester@gmail.com' ||
         request.auth.token.email.lower() == 'hello@techaidaustralia.com.au' ||
         exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower())));
    }

    match /admins/{email} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /bookings/{bookingId} {
      allow create, read: if true;
      allow write: if request.auth != null; // Authed users and admins
    }

    match /content/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /blogs/{blogId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Studio shop pickup orders (pay in studio)
    match /orders/{orderId} {
      allow create: if true;
      allow read: if isAdmin() ||
        (request.auth != null && resource.data.userId == request.auth.uid) ||
        (request.auth != null && resource.data.email == request.auth.token.email);
      allow update, delete: if isAdmin();
    }

    // Outbound notification queue (Trigger Email extension / CRM mail log)
    match /mail/{mailId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Lightweight lead log for CRM dashboards
    match /leads/{leadId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /giftcards/{cardId} {
      allow create: if true;
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /chats/{chatId} {
      allow create, read, write: if true; // Public chat can send/read, admin reads/replies
    }

    match /clients/{clientId} {
      allow read, write: if request.auth != null && (request.auth.uid == clientId || isAdmin());
    }
  }
}