rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /bookings/{bookingId} {
      allow create: if true; // Public can create bookings
      allow read, write: if request.auth != null; // Authed users can manage
    }
    match /content/{documentId} {
      allow read: if true; // Public can read content
      allow write: if request.auth != null; // Authed users can update content
    }
    match /admins/{email} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}