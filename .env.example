# ── Vercel form webhooks ──────────────────────────────────────────
# Set these in Vercel → Project → Settings → Environment Variables
# (Production + Preview). Never commit real secrets.

# Optional shared secret the site sends as X-Form-Secret
FORM_WEBHOOK_SECRET=

# Forward every form event to Zapier / Make / n8n / custom CRM
OUTBOUND_WEBHOOK_URL=
OUTBOUND_WEBHOOK_SECRET=

# Discord channel notifications (Server → Integrations → Webhooks)
DISCORD_WEBHOOK_URL=

# Email via Resend (https://resend.com)
RESEND_API_KEY=
RESEND_FROM=Diamond Tip Tattoo <hello@yourdomain.com>
NOTIFY_EMAILS=stormychaseforrester@gmail.com,hello@techaidaustralia.com.au

# Browser origins allowed to call the API (comma-separated)
# Defaults include Firebase hosting + common local ports
ALLOWED_ORIGINS=https://diamond-tip-tattoo.web.app,https://diamond-tip-tattoo.firebaseapp.com,http://localhost:5000

# ── Facebook / Meta Messenger Platform ────────────────────────────
# See META-MESSENGER-SETUP.md for the full click-path in developers.facebook.com

# You invent this string — paste the SAME value in Meta webhook "Verify token"
META_VERIFY_TOKEN=diamond_tip_messenger_verify_change_me

# From Meta app → Messenger API settings → Generate token (for your Page)
META_PAGE_ACCESS_TOKEN=

# Numeric App ID from Settings → Basic (optional; also paste into index.html meta facebook-app-id)
META_APP_ID=

# App secret (Settings → Basic) — verifies webhook signatures
META_APP_SECRET=

# Optional Page ID
META_PAGE_ID=

# After webhook works: message the Page "notify me", copy PSID from Vercel logs
# Multiple artists: comma-separated
MESSENGER_NOTIFY_PSIDS=

# Graph API version (optional)
GRAPH_API_VERSION=v21.0
