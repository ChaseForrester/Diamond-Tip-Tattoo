rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /portfolio/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /bookings/{allPaths=**} {
      allow read: if true; // Studio can open try-on previews from email/CRM links
      allow write: if true; // Public can upload reference / try-on images
    }
  }
}
