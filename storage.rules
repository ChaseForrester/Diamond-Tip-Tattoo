rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /portfolio/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /bookings/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if true; // Public can upload reference images
    }
  }
}
